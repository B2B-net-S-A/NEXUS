# Wzór pliku .env.staging.local (katalog główny repo; gitignore `.env.*.local`).
# Skopiuj, uzupełnij, nigdy nie commituj prawdziwych wartości.
#
#   cp scripts/staging/env.staging.example .env.staging.local

# ── Własne sekrety stagingu (wygeneruj: openssl rand -base64 48) ─────────────
# Inne niż na produkcji: tokeny i sesje z kopii przestają być ważne.
POSTGRES_PASSWORD=
# After a successful SSH restore set this to that new nexus_staging_* database.
# Leave nexus for scripts/staging/restore_from_backup.sh (offsite restore).
STAGING_DATABASE_NAME=nexus
SECRET_KEY=
M365_TOKEN_ENCRYPTION_KEY=
STAGING_S3_ACCESS_KEY=
STAGING_S3_SECRET_KEY=

# ── Ten sam co na produkcji ──────────────────────────────────────────────────
# HMAC tożsamości kandydata: z innym kluczem wykrywanie duplikatów na stagingu
# nie zgadzałoby się z odciskami zapisanymi w kopii bazy.
CANDIDATE_IDENTITY_FINGERPRINT_KEY=

# ── Ranking jak na produkcji ─────────────────────────────────────────────────
# Te same wartości są domyślne w docker-compose.staging.yml. Inna wartość tutaj
# ma sens tylko w pomiarze „z flagą i bez”. Zgodność sprawdza
# backend/scripts/staging_ranking_parity.py. Wartości z produkcji zapisuje co noc
# scripts/staging/nightly_sync.py w `.env.staging-flags.local` obok tego pliku;
# ten plik wygrywa z wpisami tutaj.
CHAMPION_MATCH_SIGNALS_ENABLED=true
CHAMPION_SENIORITY_PENALTY_ENABLED=true
SKILL_ALIAS_EXTENDED_ENABLED=true
HYBRID_POOL_ENABLED=true
KNOWN_PEOPLE_BOOST_ENABLED=true
KEYWORD_SEARCH_FOLDED_FTS=true
MATCH_POOL_SIZE=2000

# ── Listy klientów jak na produkcji ──────────────────────────────────────────
# MULTI_CONSULTANT_ORDER_CLIENT_IDS, COST_ORDER_CLIENT_IDS i
# EXTENDED_ORDER_ALERT_CLIENT_IDS przychodzą co noc tym samym plikiem flag. Tu ich
# nie wpisuj, bo identyfikatory klientów z produkcji mają zostać poza repo.

# ── Dostawcy AI (zapora wyjścia ich nie blokuje) ─────────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ── Kopia offsite (backup/backup.sh) — klucz B2 TYLKO DO ODCZYTU ─────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=eu-central-1
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=nexus

# ── Korpus CV: bucket produkcji, klucz TYLKO DO ODCZYTU ──────────────────────
# Źródło plików CV przy odtworzeniu i w nocnym dosłaniu (lustro w B2 ma dzienny
# limit pobrań). Bez tego klucza nocna kopia nie dosyła plików i zgłasza to w raporcie.
# Osobny klucz w panelu Hetzner Object Storage, z prawem wyłącznie do odczytu.
CV_SOURCE_ENDPOINT=
CV_SOURCE_BUCKET=nexus-candidate-documents
CV_SOURCE_ACCESS_KEY=
CV_SOURCE_SECRET_KEY=
