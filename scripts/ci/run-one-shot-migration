#!/usr/bin/env bash
set -euo pipefail

: "${MIGRATION_DATABASE_URL:?MIGRATION_DATABASE_URL is required}"

candidate_sha="${GITHUB_SHA:-$(git rev-parse HEAD)}"
if [[ ! "$candidate_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "ERROR: candidate SHA must be exactly 40 lowercase hex characters" >&2
  exit 64
fi

image="nexus-migration:${candidate_sha}"
built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

docker build \
  --build-arg "GIT_SHA=${candidate_sha}" \
  --build-arg "BUILT_AT=${built_at}" \
  --tag "$image" \
  backend

# Pass values through the environment without expanding the database URL into
# Docker's argv/log output. These process-only signing values are not runtime
# credentials and are never used by the migration itself.
export DATABASE_URL="$MIGRATION_DATABASE_URL"
export SECRET_KEY="migration-process-only-key-at-least-48-characters-long"
export M365_STATE_SIGNING_KEY="migration-process-only-independent-m365-state-key"
export DEBUG=false

docker run --rm \
  --env DATABASE_URL \
  --env SECRET_KEY \
  --env M365_STATE_SIGNING_KEY \
  --env DEBUG \
  "$image" migrate
