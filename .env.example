# ==============================
# DynaMinds ATS — Environment Variables
# Copy to .env and fill in secrets
# ==============================

# --- Application ---
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://dynaminds:dynaminds@localhost:5432/dynaminds

# --- Qdrant (vector store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=candidates

# --- Voyage AI (embeddings) ---
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_MODEL=voyage-3
EMBEDDING_DIMENSION=1024

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- File uploads ---
UPLOAD_DIR=/tmp/dynaminds/uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS (comma-separated) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
