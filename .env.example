# ==============================
# Nexus ATS — Environment Variables
# Copy to .env and fill in real values. Never commit the real .env file.
# ==============================

# --- Application ---
DEBUG=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-min-48-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- PostgreSQL ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=nexus
DATABASE_URL=postgresql+asyncpg://nexus:change-me-to-a-strong-password@localhost:5432/nexus

# --- Qdrant (vector store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# Keep populated legacy indexes active until a versioned blue/green index has
# been fully built and verified. Never point these vars at an empty collection.
QDRANT_COLLECTION=nexus_candidates
QDRANT_JOBS_COLLECTION=nexus_jobs

# --- Voyage AI (embeddings) ---
# Rotate any previously exposed key at https://dash.voyageai.com
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_MODEL=voyage-3-large
EMBEDDING_DIMENSION=1024
TALENT_RADAR_EMBEDDING_COPY_ENABLED=false
TALENT_RADAR_EMBEDDING_MODEL=
TALENT_RADAR_EMBEDDING_DIMENSION=0

# --- Ollama (local LLM, optional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Anthropic (Claude) — CV enrichment, AI job writer ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL_CV=claude-sonnet-5
CV_ENRICHMENT_ENABLED=true

# --- Generator CV B2B (/cv-generator) ---
# Model + limit tokenów dla generacji CV w szablonie B2B Network.
# Sonnet 4.6 (rewert z Sonnet 5 — regresja jakości CV przy thinking=disabled;
# powrót na Sonnet 5 wymaga CV_B2B_THINKING=adaptive + wyższego MAX_TOKENS).
CV_B2B_MODEL=claude-sonnet-4-6
CV_B2B_MAX_TOKENS=8192
# Modele zapasowe (CSV) próbowane gdy primary zwraca 529 overloaded_error —
# 529 jest per-pool, więc inny model rodzinowo ratuje generację. Pusta wartość
# wyłącza fallback. Domyślnie: claude-opus-4-8.
CV_B2B_FALLBACK_MODELS=claude-opus-4-8
# Liczba ponowień per model (overload/429/5xx) z jitterowanym backoffem.
# Steruje worst-case latency przed czystym 503 „przeciążona". Domyślnie 3.
CV_B2B_MAX_RETRIES=3
# Timeout pojedynczego wywołania Claude (sekundy). Domyślnie 120 — chroni slot
# threadpoola przed zawieszonym requestem (SDK default to 600 s).
CV_B2B_REQUEST_TIMEOUT=120
# Extended thinking. Sonnet 5 robi adaptive thinking (effort=high) DOMYŚLNIE, a
# tokeny myślenia liczą się do max_tokens → ucinały JSON CV (stop_reason=
# max_tokens). Domyślnie „disabled" (ekstrakcja nie potrzebuje rozumowania).
# Ustaw „adaptive" żeby przywrócić domyślne myślenie modelu bez redeployu.
CV_B2B_THINKING=disabled

# --- Fireflies integration ---
# Rotate any previously exposed key at https://app.fireflies.ai/settings
FIREFLIES_API_KEY=your-fireflies-api-key-here

# --- Champion Profile AI Intake (Phase 14) ---
# Model used to generate Champion Profile drafts from pasted JD and to
# enrich from Fireflies meeting / CloudTalk call transcripts.
CHAMPION_AI_MODEL=claude-sonnet-5
# Hard cap on transcript length fed to the LLM (chars). Longer transcripts are
# truncated after this length; summary + action_items always prepended.
CHAMPION_AI_MAX_TRANSCRIPT_CHARS=40000

# --- CloudTalk integration (Phase 14 — webhook ingestion) ---
# HMAC secret that CloudTalk uses to sign webhook payloads. Generate with:
#   openssl rand -hex 32
CLOUDTALK_WEBHOOK_SECRET=
# Master switch for the webhook — default false routes to dry-run (logs only).
CLOUDTALK_WEBHOOK_ENABLED=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- File uploads ---
UPLOAD_DIR=/tmp/nexus/uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS (JSON array of allowed origins) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- SMTP (email dla @mention w notatkach + chat fallback offline >15min) ---
# Default OFF: gdy SMTP_ENABLED=false, mailer jest no-op (log + return False).
# Włącz dopiero gdy masz creds (Mailgun/SES/SendGrid via SMTP relay, mailtrap.io
# do testów, lub Gmail App Password — zalecane dedykowany "noreply@" mailbox).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=nexus@b2bnet.pl
SMTP_USE_TLS=true

# --- Sentry (optional, production observability) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Ops snapshot endpoint (/api/admin/snapshot) ---
# Random hex string (e.g. `openssl rand -hex 32`). Empty = token auth disabled,
# but admin JWT still works as fallback. Used by cron + Claude Code dynaminds-ops
# subagent to fetch state without holding a user session.
SNAPSHOT_TOKEN=

# --- Proxycurl LinkedIn employment tracking (Phase: LinkedIn sync) ---
# Get a key at https://nubela.co/proxycurl/dashboard (Pay as you Go is fine,
# ~$0.01 per cached lookup). When this is empty the sync loop self-disables
# and the manual sync endpoint returns 503.
PROXYCURL_API_KEY=
PROXYCURL_ENABLED=true
# Loop tick interval (seconds). Floor 60s; 3600 = once per hour.
PROXYCURL_SYNC_INTERVAL_SECONDS=3600
# How stale a candidate's last sync must be before it gets refreshed.
# 60 days ≈ 2 months — sensible default for IT staffing.
PROXYCURL_CANDIDATE_STALE_DAYS=60
# Max candidates processed per tick (paced by 2s stagger).
PROXYCURL_BATCH_SIZE=50
# Fuzzy company-name match threshold (0..100). >= triggers "same company"
# — guards against rebrand false-positives (Acme Sp. z o.o. ↔ Acme sp z o o).
PROXYCURL_COMPANY_FUZZ_THRESHOLD=90

# --- Microsoft 365 (mailbox sync + SSO login — Phase M365.1 + Faza B) ---
# See docs/microsoft365-setup.md for Azure AD app registration walk-through.
# Kill-switch — when False the OAuth router skips registration; sync loop exits.
M365_INTEGRATION_ENABLED=true
# Azure AD App Registration values (from Azure Portal → Microsoft Entra ID).
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=
# Must match the Web Redirect URI configured in the Azure app.
M365_REDIRECT_URI=https://api.nexus.dynaminds.pl/api/microsoft365/callback
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates all stored tokens — users must reconnect.
M365_TOKEN_ENCRYPTION_KEY=
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty falls back to SECRET_KEY — override in prod.
M365_STATE_SIGNING_KEY=
# Background sync loop. Default OFF; flip true once stable.
M365_SYNC_LOOP_ENABLED=false
M365_SYNC_INTERVAL_SECONDS=300
M365_BACKFILL_MONTHS=12
M365_IGNORE_CATEGORY=ATS:ignore
M365_AUTO_PARSE_CV=true
# Max attachment size in MB to download (skipped above this).
M365_MAX_ATTACHMENT_MB=25

# --- "Sign in with Microsoft" SSO login (Faza B) ---
# Reuses M365_CLIENT_ID/SECRET/TENANT_ID — same Azure AD app, second redirect URI.
MICROSOFT_LOGIN_REDIRECT_URI=https://api.nexus.dynaminds.pl/api/auth/microsoft/callback
# CSV of email-domain whitelist for auto-provisioning. Empty rejects every domain.
SSO_ALLOWED_DOMAINS=b2bnetwork.pl
