{
  "manifest_version": 3,
  "name": "NEXUS — LinkedIn",
  "short_name": "NEXUS",
  "version": "1.0.0",
  "description": "Panel boczny NEXUSA na LinkedInie: sprawdź osobę w bazie, dodaj ją do rekrutacji i zapisz kontakt.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "NEXUS — otwórz panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://nexus.b2bnetwork.pl/*",
    "https://api.nexus.b2bnetwork.pl/*",
    "https://api.nexus.dynaminds.pl/*",
    "http://localhost:8100/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://nexus.b2bnetwork.pl/*",
      "http://localhost:3100/*",
      "http://localhost:3101/*"
    ]
  }
}
